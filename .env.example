# Copy this file to .env and fill in the values.

# ── Gemini AI ──────────────────────────────────────────────────────────────
# API key for the Gemini generative-AI service (used by the accreditation agent).
# Obtain a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Other env vars ─────────────────────────────────────────────────────────
# PORT=3000
# REDIS_URL=redis://localhost:6379
# GOOGLE_SHEET_URL=https://script.google.com/macros/s/.../exec
# FIREBASE_SERVICE_ACCOUNT_BASE64=...
# SUPER_ADMIN_USERS=0500000000

# ── Connection stability / reverse-proxy tuning ─────────────────────────────
# Set to the number of trusted proxy hops in front of Node (e.g. "1" for a
# single Nginx/ELB/Cloudflare hop), "true"/"false", or a comma-separated list
# of proxy IPs/CIDRs. Required for correct req.ip / per-user rate limiting
# when running behind any reverse proxy or load balancer.
# TRUST_PROXY=1
# Keep ABOVE your reverse proxy/load balancer's idle-connection timeout to
# avoid ECONNRESET races on keep-alive connections. headersTimeout must stay
# greater than keepAliveTimeout (enforced automatically if unset).
# HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
# HTTP_HEADERS_TIMEOUT_MS=70000
# HTTP_REQUEST_TIMEOUT_MS=0
# TCP_KEEP_ALIVE_DELAY_MS=30000
# Socket.IO real-time connection tuning (chat/notifications).
# SOCKET_IO_PING_INTERVAL_MS=20000
# SOCKET_IO_PING_TIMEOUT_MS=10000
# SOCKET_IO_CONNECT_TIMEOUT_MS=20000
# SOCKET_IO_RECOVERY_WINDOW_MS=60000
