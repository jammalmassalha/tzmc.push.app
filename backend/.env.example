INFORU_SMS_URL=https://uapi.inforu.co.il/SendMessageXml.ashx
INFORU_USERNAME=
INFORU_API_TOKEN=
INFORU_SENDER=Tzafon

SESSION_SIGNING_SECRET=
SESSION_JWE_SECRET=

# VAPID keys for web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Dovrut (דוברות) community group write access
DOVRUT_GROUP_ID=דוברות
DOVRUT_ALLOWED_WRITERS=
SUBSCRIPTION_LOOKUP_BATCH_SIZE=40

# JSON object map, for example: {"shuttle-reminder-2h":"https://example.com/webhook"}
WEBHOOK_REGISTRY_JSON={}

# --- Web Integrated Windows Authentication (SSO) ---
# Off by default. Only enable once a reverse proxy in front of Node terminates
# the Negotiate handshake AND strips any client-supplied identity header on
# ingress; otherwise anyone could send the header themselves and impersonate a
# user. Node must also be bound to localhost / the internal network so the proxy
# cannot be bypassed. See flutter_app/PLATFORM_SETUP.md.
WINDOWS_SSO_ENABLED=false
# Header the proxy injects with the authenticated principal (DOMAIN\user or UPN).
WINDOWS_SSO_USER_HEADER=X-Remote-User
# Optional defence in depth for when the proxy and Node are not on the same
# host: the proxy must also send an HMAC-SHA256 (hex) of the normalized,
# lowercased account name, keyed with this secret.
WINDOWS_SSO_SIGNATURE_HEADER=X-Remote-User-Signature
WINDOWS_SSO_SIGNATURE_SECRET=
