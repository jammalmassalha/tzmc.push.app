GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_GOOGLE_SHEET_SCRIPT_ID/exec
LOGS_BACKUP_SHEET_URL=https://script.google.com/macros/s/YOUR_BACKUP_SHEET_SCRIPT_ID/exec
SHUTTLE_USER_ORDERS_URL=https://script.google.com/macros/s/YOUR_SHUTTLE_SCRIPT_ID/exec
APP_SERVER_TOKEN=
CHECK_QUEUE_SERVER_TOKEN=

LOGS_DB_HOST=127.0.0.1
LOGS_DB_PORT=3306
LOGS_DB_USER=your_db_user
LOGS_DB_PASSWORD=your_db_password
LOGS_DB_NAME=your_db_name
LOGS_DB_TABLE=Logs
LOGS_DB_CONNECTION_LIMIT=5

# ── Licenser / Employment DB ───────────────────────────────────────────────
# Second MySQL database used to verify that a restricted user's phone number
# exists in the employment table before dispatching the SMS verification code.
# Leave LICENSER_DB_HOST empty to disable the licenser check entirely.
LICENSER_DB_HOST=
LICENSER_DB_PORT=3306
LICENSER_DB_USER=
LICENSER_DB_PASSWORD=
LICENSER_DB_NAME=
LICENSER_DB_TABLE=employ
LICENSER_DB_PHONE_COLUMN=Phone
LICENSER_DB_CONNECTION_LIMIT=3
# How long (ms) to wait for the employ table before sending the SMS anyway.
LICENSER_WAIT_MS=45000
# How often (ms) to poll the employ table during the wait.
LICENSER_POLL_INTERVAL_MS=3000

REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=tzmc:notify

SESSION_SIGNING_SECRET=
SESSION_JWE_SECRET=

# VAPID keys for web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Dovrut (דוברות) community group write access
DOVRUT_GROUP_ID=דוברות
DOVRUT_ALLOWED_WRITERS=
SUBSCRIPTION_LOOKUP_BATCH_SIZE=40

# JSON object map, for example: {"shuttle-reminder-2h":"https://example.com/webhook"}
WEBHOOK_REGISTRY_JSON={}
