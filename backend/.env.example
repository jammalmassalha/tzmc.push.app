LOGS_BACKUP_SHEET_URL=https://script.google.com/macros/s/YOUR_BACKUP_SHEET_SCRIPT_ID/exec
SHUTTLE_USER_ORDERS_URL=https://script.google.com/macros/s/YOUR_SHUTTLE_SCRIPT_ID/exec
APP_SERVER_TOKEN=
CHECK_QUEUE_SERVER_TOKEN=

LOGS_DB_HOST=127.0.0.1
LOGS_DB_PORT=3306
LOGS_DB_USER=your_db_user
LOGS_DB_PASSWORD=your_db_password
LOGS_DB_NAME=your_db_name
LOGS_DB_TABLE=Logs
LOGS_DB_CONNECTION_LIMIT=5

REDIS_URL=redis://127.0.0.1:6379
